# Variables que consume docker-compose.yml.
# Copiar a .env y completar antes de levantar el entorno:
#
#   cp .env.sample .env
#
# En desarrollo alcanza con dejar todo como está salvo JWT_SECRET, que no
# tiene valor por defecto a propósito.

# --- Obligatoria ---
# Firma los tokens. Sin esta variable el backend no arranca, para que nunca
# quede en línea firmando con un secreto que está escrito en el repositorio.
# Generar con: openssl rand -hex 32
JWT_SECRET=

# --- Producción ---
# IP pública o dominio de la instancia. El frontend se compila apuntando acá,
# así que hay que reconstruirlo si cambia.
EC2_IP=localhost

# Origen que el backend acepta por CORS. Tiene que ser la URL desde la que se
# abre el frontend, no la del backend.
# Ejemplo en EC2 detrás de nginx: http://54.12.34.56
CORS_ORIGIN=http://localhost:3040

# Contraseña de PostgreSQL. Cambiarla antes de exponer la base.
POSTGRES_PASSWORD=postgres
